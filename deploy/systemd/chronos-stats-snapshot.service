[Unit]
Description=Chronos stats snapshot (player stat files + scoreboards -> SQLite)
# Purely local file reads; no network dependency beyond the one-off dictionary
# fetch, which snapshot.py already tolerates failing.
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/chronos/Chronos-Bot
ExecStart=/opt/python/bin/python3 bot/snapshot.py
# A run normally takes seconds; anything past this is hung (e.g. a stuck
# filesystem), so kill it rather than let it block every later timer tick.
TimeoutStartSec=10min
# Don't compete with the Minecraft servers for CPU/disk.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
